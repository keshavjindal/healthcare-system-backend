enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum HealthRecordType {
  FILE
  FORM
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ChangeType {
  CREATED
  UPDATED
  DELETED
}

