// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password      String
  role          Role
  ethereumAddress String  @unique
  encryptedJSON String @unique
  photo         Bytes?    // Store actual photo content
  points        Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  dateOfBirth   DateTime?
  sessions      UserSession[]
  loginAttempts LoginAttempt[]
  patientAppointments Appointment[] @relation("PatientAppointments")
  doctorAppointments Appointment[] @relation("DoctorAppointments")
  healthRecords HealthRecord[] @relation("HealthRecords")
  recordChanges HealthRecordChange[] @relation("ChangeMadeBy")
  gender        Gender?
  specialization String? // only for doctors
}

model UserSession {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id])
  userId        String
  ipAddress     String
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())
}

model LoginAttempt {
  id            String    @id @default(uuid())
  user          User?      @relation(fields: [userId], references: [id])
  userId        String?
  ipAddress     String
  attemptTime   DateTime  @default(now())
  isSuccess     Boolean
}

model Appointment {
  id          String   @id @default(uuid())
  patientId   String
  patient     User     @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorId    String
  doctor      User     @relation("DoctorAppointments", fields: [doctorId], references: [id])
  dateTime    DateTime
  status      AppointmentStatus
  paymentStatus PaymentStatus
  paymentMethod PaymentMethod
  amount      Int      // Amount in USD or points depending on payment method
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HealthRecord {
  id          String   @id @default(uuid())
  patientId   String
  patient     User     @relation("HealthRecords", fields: [patientId], references: [id])
  recordData  Bytes
  recordName  String
  recordSize  Int
  recordType  HealthRecordType
  dataHash    String
  mimeType    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  changes     HealthRecordChange[]
  isHashVerified Boolean?
}

model HealthRecordChange {
  id              String   @id @default(uuid())
  healthRecord    HealthRecord @relation(fields: [healthRecordId], references: [id])
  healthRecordId  String
  changedBy       User     @relation("ChangeMadeBy", fields: [changedById], references: [id])
  changedById     String
  changeType      ChangeType
  description     String
  transactionHash String   // Ethereum transaction hash
  createdAt       DateTime @default(now())
}

